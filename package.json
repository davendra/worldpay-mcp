{
  "name": "@worldpay/worldpay-mcp",
  "version": "1.2.0",
  "description": "Worldpay MCP Server",
  "main": "dist/server-http.js",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "bin": "dist/server-stdio.js",
  "scripts": {
    "build": "tsc --build && tsc-alias",
    "start": "node dist/server-http.js",
    "dev": "npm run build && npm run start",
    "test": "jest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Worldpay",
  "keywords": [
    "worldpay",
    "mcp",
    "payments",
    "paybylink",
    "hostedpaymentpages",
    "tokens"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "winston": "^3.17.0",
    "zod": "^4.3.5"
  },
  "overrides": {
    "express": {
      "qs": "^6.14.2"
    },
    "@modelcontextprotocol/sdk": {
      "ajv": "^8.18.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fetch-mock/jest": "^0.2.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20"
  }
}
