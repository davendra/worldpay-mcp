# --- Required (all transports) ---
WORLDPAY_USERNAME=<INSERT_USERNAME>
WORLDPAY_PASSWORD=<INSERT_PASSWORD>
WORLDPAY_URL=https://try.access.worldpay.com
MERCHANT_ENTITY=<INSERT_MERCHANT_ENTITY>

# --- Optional ---
# Outbound Worldpay API request timeout in ms (default 30000).
#WORLDPAY_TIMEOUT_MS=30000
# Log level and file (default info, ./worldpay-mcp.log). The log may contain
# request metadata; treat it as sensitive and rotate it.
#LOG_LEVEL=info
#LOG_FILE=worldpay-mcp.log

# --- HTTP transport only (node dist/server-http.js) ---
# REQUIRED to start the HTTP transport: a strong random bearer token that
# clients must present as `Authorization: Bearer <token>` on /mcp.
# Generate one with: openssl rand -hex 32
#MCP_AUTH_TOKEN=<STRONG_RANDOM_TOKEN>
# Interface to bind (default 127.0.0.1 — do not expose publicly without a proxy).
#HOST=127.0.0.1
# Port (default 3001).
#PORT=3001
# Comma-separated allowed browser origins for CORS. Unset = same-origin only.
# Never set to "*" together with credentials.
#CORS_ORIGIN=https://your-client.example.com
# Comma-separated extra Host header values accepted (DNS-rebinding allowlist);
# host:port for the bind address is allowed automatically.
#MCP_ALLOWED_HOSTS=
# Session limits.
#MCP_MAX_SESSIONS=100
#MCP_SESSION_TTL_MS=1800000
